<policies>
  <inbound>
    <base />
    <set-variable name="correlationId" value="@(context.RequestId.ToString())" />
    <set-header name="X-Correlation-Id" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="Authorization" exists-action="delete" />
    <set-query-parameter name="subscription-key" exists-action="delete" />
    <choose>
      <when condition="@(!System.Text.RegularExpressions.Regex.IsMatch(context.Request.MatchedParameters.GetValueOrDefault(&quot;policyId&quot;, &quot;&quot;), &quot;^POL[0-9]{4}$&quot;))">
        <return-response>
          <set-status code="400" reason="Bad Request" />
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-header name="X-Correlation-Id" exists-action="override"><value>@((string)context.Variables["correlationId"])</value></set-header>
          <set-body>@(new JObject(new JProperty("code", "InvalidPolicyId"), new JProperty("message", "Use POL followed by four digits."), new JProperty("correlationId", (string)context.Variables["correlationId"])).ToString())</set-body>
        </return-response>
      </when>
    </choose>
    <set-backend-service base-url="{{pair-01-backend-url}}/pairs/{{pair-01-id}}/{{pair-01-fixture-stage}}" />
  </inbound>
  <backend><base /></backend>
  <outbound>
    <base />
    <set-header name="X-Correlation-Id" exists-action="override"><value>@((string)context.Variables["correlationId"])</value></set-header>
    <set-header name="X-Lab-Route" exists-action="override"><value>{{pair-01-fixture-stage}}</value></set-header>
    <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
  </outbound>
  <on-error>
    <base />
    <return-response>
      <set-status code="502" reason="Bad Gateway" />
      <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
      <set-header name="X-Correlation-Id" exists-action="override"><value>@(context.RequestId.ToString())</value></set-header>
      <set-body>@(new JObject(new JProperty("code", "GatewayFailure"), new JProperty("message", "The gateway could not complete the provider request."), new JProperty("correlationId", context.RequestId.ToString())).ToString())</set-body>
    </return-response>
  </on-error>
</policies>
