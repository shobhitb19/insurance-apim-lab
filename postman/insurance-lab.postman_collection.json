{
  "info": {
    "name": "Insurance APIM guided lab",
    "description": "Synthetic data only. Run Provider locally; gateway folders require facilitator readiness. Run baseline OR extended for the current checkpoint, not both. Gateway exercises have not been validated against your Azure service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Provider (local, no key)",
      "item": [
        {
          "name": "Baseline policy",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{fixtureBaseUrl}}/pairs/{{pairId}}/baseline/policies/POL1001",
            "description": "Expected 200. No response body or credentials are written to the console."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Expected response body', () => pm.expect(body).to.deep.equal({\"policyId\":\"POL1001\",\"status\":\"Active\",\"product\":\"Home\"}));",
                  "pm.test('Safe correlation header', () => pm.expect(pm.response.headers.get('X-Correlation-Id')).to.match(/^[A-Za-z0-9-]{1,64}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Extended policy",
          "request": {
