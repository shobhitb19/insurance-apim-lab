{
  "openapi": "3.0.3",
  "info": {
    "title": "Fictional policy provider - extended",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7071/pairs/pair-01/extended"
    }
  ],
  "paths": {
    "/policies/{policyId}": {
      "get": {
        "operationId": "getPolicy",
        "parameters": [
          {
            "name": "policyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^POL[0-9]{4}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider-owned extension",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "policyId",
                    "status",
                    "product",
                    "riskCategory"
                  ],
                  "properties": {
                    "policyId": {
                      "type": "string",
                      "pattern": "^POL[0-9]{4}$"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "Active"
                      ]
                    },
                    "product": {
                      "type": "string",
                      "enum": [
                        "Home",
                        "Motor"
                      ]
                    },
                    "riskCategory": {
                      "type": "string",
                      "enum": [
                        "Standard",
                        "Elevated"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Policy not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message",
                    "correlationId"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "correlationId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
