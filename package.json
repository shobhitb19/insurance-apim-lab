{
  "name": "insurance-apim-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Synthetic, mock-backed API Management guided workshop",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "mock": "node mock/server.mjs",
    "contracts": "node scripts/export-contracts.mjs",
    "postman": "node scripts/export-postman.mjs",
    "build": "npm run contracts && npm run postman && node scripts/build-site.mjs",
    "test": "node --test",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.0.3",
    "@exodus/schemasafe": "1.3.0",
    "fast-xml-parser": "5.11.2",
    "markdown-it": "14.3.3"
  }
}
