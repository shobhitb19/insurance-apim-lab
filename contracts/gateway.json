{
  "openapi": "3.0.3",
  "info": { "title": "Insurance gateway - extended workshop checkpoint", "version": "1.1.0" },
  "servers": [{ "url": "https://gateway.example.invalid/pair-01/insurance" }],
  "security": [{ "subscriptionKey": [] }],
  "components": {
    "securitySchemes": { "subscriptionKey": { "type": "apiKey", "in": "header", "name": "Ocp-Apim-Subscription-Key" } },
    "responses": {
      "Error": { "description": "Workshop error contract", "content": { "application/json": { "schema": { "$ref": "schemas.json#/definitions/Error" } } } },
      "Unauthorized": { "description": "APIM built-in missing/invalid subscription key; policies may not run", "content": { "application/json": { "schema": { "type": "object", "required": ["statusCode", "message"], "properties": { "statusCode": { "type": "integer" }, "message": { "type": "string" } } } } } }
    }
  },
  "paths": {
    "/policies/{policyId}": {
      "get": {
        "operationId": "getPolicy",
        "parameters": [{ "name": "policyId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^POL[0-9]{4}$" } }],
        "responses": {
          "200": { "description": "Extended policy after module 6", "content": { "application/json": { "schema": { "$ref": "schemas.json#/definitions/ExtendedPolicy" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/policies/{policyId}/overview": {
      "get": {
        "operationId": "getPolicyOverview",
        "parameters": [{ "name": "policyId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^POL[0-9]{4}$" } }],
        "responses": {
          "200": { "description": "Bounded synchronous policy and claims read", "content": { "application/json": { "schema": { "$ref": "schemas.json#/definitions/Overview" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  }
}
